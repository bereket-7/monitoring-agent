# Application
APP_ENV=development
APP_NAME=monitoring-dashboard-agent
LOG_LEVEL=INFO
API_PREFIX=/api/v1
REQUEST_TIMEOUT_SECONDS=30

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15432/monitoring_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Grafana (read-only token recommended)
GRAFANA_URL=http://localhost:3000
GRAFANA_API_TOKEN=
GRAFANA_TIMEOUT_SECONDS=15

# Prometheus
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT_SECONDS=15
PROMETHEUS_MAX_RESPONSE_BYTES=1048576

# Loki (optional in MVP; degrade gracefully when unset)
LOKI_URL=
LOKI_TIMEOUT_SECONDS=15
LOKI_MAX_RESPONSE_BYTES=1048576

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Agent bounds
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_ANALYSIS_SECONDS=120

# Validation
VALIDATION_CONSISTENCY_TOLERANCE=0.02

# Security / query limits
MAX_QUERY_LENGTH=4096
MAX_TIME_RANGE_SECONDS=604800
QUERY_CONCURRENCY_LIMIT=8
